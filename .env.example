# OPENROUTER_API_KEY: Primary key for OpenRouter API (Claude 3.5 Sonnet, Claude 3 Haiku, Gemini, etc.).
OPENROUTER_API_KEY=""

# ANTHROPIC_API_KEY: Also supported for compatibility with OpenRouter or Anthropic keys.
ANTHROPIC_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
